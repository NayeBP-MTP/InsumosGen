# Copia este archivo como .env y completa los valores reales.
# Este archivo NO debe contener credenciales reales.

BASE_URL=https://originacion-uat.providigital.com/v1/app/login
ESTRELLA=tu_numero_estrella
PASSWORD=tu_contrasena

# Conexiones a SQL Server: una por HOST, con el nombre del host (no de la base).
# La base de datos no va aquí: el mapeo base -> host vive en config/databases.py.
# Ver config/Context/crearClientesFC/CREAR_CLIENTES.md (decisión 4).

# Host Pesos_Offer: bases botDB (ofertas) y Originacion (expedientes)
PESOS_OFFER_SERVER=tu_servidor_sql
PESOS_OFFER_USER=tu_usuario
PESOS_OFFER_PASSWORD=tu_contrasena
PESOS_OFFER_DRIVER=ODBC Driver 17 for SQL Server

# Host CNFS: base CNFS_uat (Customer, Agreement, Customer_Address)
CNFS_SERVER=tu_servidor_sql
CNFS_USER=tu_usuario
CNFS_PASSWORD=tu_contrasena
CNFS_DRIVER=ODBC Driver 17 for SQL Server

# Host Challenger: base Challenger_uat (flujo de generación de agencias)
CHALLENGER_SERVER=tu_servidor_sql
CHALLENGER_USER=tu_usuario
CHALLENGER_PASSWORD=tu_contrasena
CHALLENGER_DRIVER=ODBC Driver 17 for SQL Server

# Hosts sin uso por ahora (se agregan cuando un flujo los necesite):
# CUSTOMER_APP_SERVER / _USER / _PASSWORD / _DRIVER
# PAYMENTLINK_SERVER / _USER / _PASSWORD / _DRIVER
