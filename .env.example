# Copia este archivo como .env y completa los valores reales.
# Este archivo NO debe contener credenciales reales.

BASE_URL=https://originacion-uat.providigital.com/v1/app/login
ESTRELLA=tu_numero_estrella
PASSWORD=tu_contrasena

# Conexión a SQL Server (botDB) para el flujo de Cliente Frecuente
# insertar oferta en dbo.Ofertas (services/offer_repository.py)
BOTDB_SERVER=tu_servidor_sql
BOTDB_DATABASE=botDB
BOTDB_USER=tu_usuario
BOTDB_PASSWORD=tu_contrasena
BOTDB_DRIVER=ODBC Driver 17 for SQL Server

# Conexión a SQL Server (Challenger) para el flujo de Generación de Agencias
CHALLENGER_SERVER=tu_servidor_sql
CHALLENGER_DATABASE=Challenger_uat
CHALLENGER_USER=tu_usuario
CHALLENGER_PASSWORD=tu_contrasena
CHALLENGER_DRIVER=ODBC Driver 17 for SQL Server
